# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server only. NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CV_PARSE=
OPENROUTER_MODEL_CV_VISION=
OPENROUTER_MODEL_EMBED=openai/text-embedding-3-small
OPENROUTER_MODEL_GRADER=
OPENROUTER_MODEL_PERSONA=
OPENROUTER_MODEL_INTERVIEWER=
OPENROUTER_MODEL_TRANSCRIBE=openai/gpt-transcribe
CRON_SECRET=
# Retention purge: peppers the hashed ids kept in the decision archive. Server only, 16+ characters.
# Required in production: without it purges pause (the compliance page shows why).
RETENTION_PEPPER=

# JEV (TypeSafe System One). Server only.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# SWE Test 1 harness: dispatch the repo checks to GitHub Actions (optional; without them the
# admin panel shows the local command). The workflow file must exist on GITHUB_ACTIONS_REF.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPO=
GITHUB_ACTIONS_REF=main
GITHUB_ACTIONS_WORKFLOW=verify-swe1.yml
