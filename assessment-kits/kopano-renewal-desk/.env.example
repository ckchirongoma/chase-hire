# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `npx supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).

# Browser-safe: the project URL and the publishable (anon) key only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Used by `npm run seed`, never by the app's request handlers, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI summary (server only). The model lives in config, not code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: point at the local stub (`npm run ai:stub`) for offline runs.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Seed logins (optional; a random password is generated and printed when unset).
SEED_PASSWORD=
