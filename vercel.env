# Chase hiring platform: environment variables for Vercel.
#
# How to use: Vercel → Project → Settings → Environment Variables → "Import .env" → pick this file
# (or paste its contents). Then replace every value that starts with REPLACE_ in the Vercel UI.
# Never type real secrets into this file: it lives in the repository.

# ── Supabase ("Chase hire" project). Public by design: already filled in. ──
NEXT_PUBLIC_SUPABASE_URL=https://mbouamkgdemhyulsjeck.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_G6BZ2XCaRZ3YsxODkBgeqA_5IqpkfuR

# Supabase dashboard → Project Settings → API Keys → "secret" key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=REPLACE_with_supabase_secret_key

# ── OpenRouter (every AI call). openrouter.ai → Keys. ──
OPENROUTER_API_KEY=REPLACE_with_openrouter_key
# Models: already chosen, change any time (re-run calibration after changing the grader).
OPENROUTER_MODEL_CV_PARSE=google/gemini-3.8-flash
OPENROUTER_MODEL_CV_VISION=google/gemini-3.8-flash
OPENROUTER_MODEL_EMBED=openai/text-embedding-3-small
OPENROUTER_MODEL_GRADER=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_PERSONA=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_INTERVIEWER=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_TRANSCRIBE=openai/gpt-transcribe

# ── JEV (TypeSafe System One): the key you already have. ──
TYPESAFE_API_KEY=REPLACE_with_typesafe_key
JEV_MODEL=jev-1.13.0

# ── Two secrets you make up: any long random string (40+ characters) each. ──
# CRON_SECRET protects the daily background job. RETENTION_PEPPER protects the purge archive:
# set it once and never change it.
CRON_SECRET=REPLACE_with_a_long_random_string
RETENTION_PEPPER=REPLACE_with_another_long_random_string
